    "brand_assets": "all-rights-reserved",
    "license_map": "https://github.com/gitljz0329/bunnybook-curriculum/blob/main/LICENSE.md",
    "attribution": "Contains information from BunnyBook Curriculum Graph, made available under ODbL 1.0. BunnyBook-authored text is Copyright 2026 lixiaozuyi and licensed under CC BY 4.0."
  },
  "forking": {
    "supported": true,
    "guide": "/docs/BUILD_YOUR_OWN.md",
    "first_config_file": "/site-config.js",
    "canonical_graph_file": "/mvp/learning-map.json",
    "brand_reuse_granted": false
  }
}
